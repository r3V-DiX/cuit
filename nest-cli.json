{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/auth-service",
  "sourceRoot": "apps/auth-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/auth-service/tsconfig.build.json"
  },
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.build.json"
      }
    },
    "user-settings-service": {
      "type": "application",
      "root": "apps/user-settings-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-settings-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-settings-service/tsconfig.build.json"
      }
    },
    "seeker-profile-service": {
      "type": "application",
      "root": "apps/seeker-profile-service",
      "entryFile": "main",
      "sourceRoot": "apps/seeker-profile-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/seeker-profile-service/tsconfig.build.json"
      }
    }
  }
}
