# -------------------------
# Application Configuration
# -------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# -------------------------
# Services PORTs
# -------------------------
AUTH_PORT=4001
SETTINGS_PORT=4002
SEEKER_PROFILE_PORT=4003
EMPLOYER_PORT=4004
SEEKER_PORT=4005
PUBLIC_PORT=4006
NOTIFICATION_PORT=4007
SUBSCRIPTION_PORT=4008
GATEWAY_PORT=5000
ADMIN_PORT=4010

# -------------------------
# Inter-service URLs (used by admin-app proxy and gateway)
# -------------------------
AUTH_SERVICE_URL=http://localhost:4001
SETTINGS_SERVICE_URL=http://localhost:4002
SEEKER_PROFILE_SERVICE_URL=http://localhost:4003
EMPLOYER_SERVICE_URL=http://localhost:4004
SEEKER_SERVICE_URL=http://localhost:4005
PUBLIC_SERVICE_URL=http://localhost:4006
NOTIFICATION_SERVICE_URL=http://localhost:4007
SUBSCRIPTION_SERVICE_URL=http://localhost:4008

# -------------------------
# Response Meta
# -------------------------
INCLUDE_META_IN_PRODUCTION=false
INCLUDE_REQUEST_ID=true
INCLUDE_TIMESTAMP=true
INCLUDE_PATH=true

# -------------------------
# Cookie Configuration
# -------------------------
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# -------------------------
# Auth
# -------------------------
JWT_SECRET=change-this-secret-in-production
CSRF_SECRET=change-this-csrf-secret-in-production
BCRYPT_ROUNDS=12

# -------------------------
# Admin
# -------------------------
ADMIN_EMAIL=support@cykruit.com
ADMIN_URL=http://localhost:3001

# -------------------------
# Database
# -------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/cykruit_db

# -------------------------
# Redis
# -------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_THROTTLER_DB=2

# -------------------------
# Email (Resend)
# -------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=info@cykruit.com

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=verbose

# -------------------------
# AWS S3 (file uploads)
# -------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_SEEKER_PHOTOS=cykruit-jobseeker-photos-prod
S3_RESUMES=cykruit-resumes-prod
S3_COMPANY_LOGOS=cykruit-company-logos-prod
S3_KYC_DOCUMENTS=cykruit-kyc-documents-prod
S3_COMPANY_BANNER=cykruit-company-banner-prod
S3_JOBSEEKER_CERTIFICATIONS=cykruit-jobseeker-certifications-prod
S3_COMPANY_MEDIA=cykruit-company-banner-prod

# Base URL that locally-uploaded files (UPLOAD_DRIVER=local, dev only) are
# served from — only seeker-profile-service exposes /uploads statically today.
LOCAL_UPLOAD_BASE_URL=http://localhost:4003

# -------------------------
# Encryption
# -------------------------
MESSAGE_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# -------------------------
# Google OAuth
# -------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -------------------------
# AI — Amazon Bedrock
# -------------------------
AI_PROVIDER=bedrock
BEDROCK_AWS_REGION=us-east-1
BEDROCK_AWS_ACCESS_KEY_ID=your_bedrock_aws_access_key_id
BEDROCK_AWS_SECRET_ACCESS_KEY=your_bedrock_aws_secret_access_key
BEDROCK_MODEL_LARGE=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_SMALL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# -------------------------
# Razorpay
# -------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -------------------------
# Network
# -------------------------
TRUSTED_PROXY_COUNT=0
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
