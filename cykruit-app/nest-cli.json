{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/auth-service",
  "sourceRoot": "apps/auth-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/auth-service/tsconfig.build.json"
  },
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.build.json"
      }
    },
    "user-settings-service": {
      "type": "application",
      "root": "apps/user-settings-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-settings-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-settings-service/tsconfig.build.json"
      }
    },
    "seeker-profile-service": {
      "type": "application",
      "root": "apps/seeker-profile-service",
      "entryFile": "main",
      "sourceRoot": "apps/seeker-profile-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/seeker-profile-service/tsconfig.build.json"
      }
    },
    "permissions": {
      "type": "library",
      "root": "libs/permissions",
      "entryFile": "index",
      "sourceRoot": "libs/permissions/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    },
    "events": {
      "type": "library",
      "root": "libs/events",
      "entryFile": "index",
      "sourceRoot": "libs/events/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    },
    "seeker-service": {
      "type": "application",
      "root": "apps/seeker-service",
      "entryFile": "main",
      "sourceRoot": "apps/seeker-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/seeker-service/tsconfig.build.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.build.json"
      }
    },
    "employer-service": {
      "type": "application",
      "root": "apps/employer-service",
      "entryFile": "main",
      "sourceRoot": "apps/employer-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/employer-service/tsconfig.build.json"
      }
    },
    "public-service": {
      "type": "application",
      "root": "apps/public-service",
      "entryFile": "main",
      "sourceRoot": "apps/public-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/public-service/tsconfig.build.json"
      }
    },
    "subscription-service": {
      "type": "application",
      "root": "apps/subscription-service",
      "entryFile": "main",
      "sourceRoot": "apps/subscription-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/subscription-service/tsconfig.build.json"
      }
    }
  }
}
