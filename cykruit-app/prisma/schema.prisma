// 1. ROLES (Pre-populated master data for cybersecurity roles)
model Role {
    id          String   @id @default(uuid())
    name        String   @unique // e.g., "Security Analyst", "Penetration Tester"
    description String?  @db.Text
    category    String? // e.g., "Offensive Security", "Defensive Security"
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    jobs Job[]

    @@index([name])
    @@index([category])
    @@map("roles")
}

// 2. MAIN JOB MODEL

model Job {
    id         String   @id @default(uuid())
    employerId String
    employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

    jobTitle         String?
    slug             String    @unique
    roleId           String?
    role             Role?     @relation(fields: [roleId], references: [id])
    jobType          JobType
    contractDuration Int?
    workMode         WorkMode
    locationId       String?
    location         Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

    experienceLevel ExperienceLevel
    description     String?         @db.Text

    applicationType    ApplicationType
    externalUrl        String?
    screeningQuestions Json?

    status          JobStatus
    rejectionReason String?   @db.Text

    closedReason String?   @db.VarChar(200)
    closedAt     DateTime?

    viewCount        Int @default(0)
    applicationCount Int @default(0)

    expiresAt   DateTime?
    publishedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    skills         JobSkill[]
    certifications JobCertification[]
    applications   Application[]
    savedByUsers   SavedJob[] // ✅ ADD THIS
    profileViews   ProfileView[] // ✅ ADD THIS
    conversations  Conversation[]
    jobViews       JobView[]

    @@index([employerId])
    @@index([roleId])
    @@index([status])
    @@index([status, expiresAt])
    @@index([jobType])
    @@index([workMode])
    @@index([locationId])
    @@index([expiresAt])
    @@index([createdAt])
    @@index([slug])
    @@map("jobs")
}

// 3. JOB SKILLS (Junction table - Many-to-Many)
model JobSkill {
    id      String @id @default(uuid())
    jobId   String
    skillId String

    job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
    skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([jobId, skillId]) // Prevent duplicate skills for same job
    @@index([jobId])
    @@index([skillId])
    @@map("job_skills")
}

// 4. JOB CERTIFICATIONS (Junction table - Many-to-Many)
model JobCertification {
    id              String @id @default(uuid())
    jobId           String
    certificationId String

    job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
    certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([jobId, certificationId]) // Prevent duplicate certs for same job
    @@index([jobId])
    @@index([certificationId])
    @@map("job_certifications")
}

model JobView {
    id       String   @id @default(uuid())
    jobId    String
    viewerId String // Logged-in user only
    viewedAt DateTime @default(now())

    job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
    viewer User @relation(fields: [viewerId], references: [id], onDelete: Cascade)

    @@unique([jobId, viewerId]) // ✅ one view per user per job
    @@index([jobId])
    @@index([viewerId])
    @@map("job_views")
}

model Application {
    id       String @id @default(uuid())
    jobId    String
    seekerId String

    // Screening answers (JSON)
    screeningAnswers Json?

    // Resume used for this application
    resumeId String?
    resume   Resume? @relation(fields: [resumeId], references: [id])

    // Status tracking
    status ApplicationStatus @default(APPLIED)

    // AI Score (cached)
    aiScore     Int? // 0-100
    aiScoreData Json? // Detailed breakdown
    aiScoredAt  DateTime?

    // Timestamps
    appliedAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
    jobSeeker User @relation(fields: [seekerId], references: [id], onDelete: Cascade)

    statusHistory ApplicationStatusHistory[]
    notes         ApplicationNote[]

    @@unique([jobId, seekerId]) // Can't apply twice to same job
    @@index([seekerId])
    @@index([jobId])
    @@index([status])
    @@map("applications")
}

model ApplicationStatusHistory {
    id            String @id @default(uuid())
    applicationId String

    oldStatus ApplicationStatus
    newStatus ApplicationStatus

    changedBy   String // User ID who changed it
    changedById String? // For tracking employer
    reason      String? // Optional reason for change

    changedAt DateTime @default(now())

    application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

    @@index([applicationId])
    @@map("application_status_history")
}

model ApplicationNote {
    id            String @id @default(uuid())
    applicationId String

    note      String @db.Text
    createdBy String // Employer user ID

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

    @@index([applicationId])
    @@map("application_notes")
}

// SAVED JOBS (Bookmarks)
model SavedJob {
    id       String @id @default(uuid())
