    updatedAt DateTime @updatedAt

    // Relations
    jobSeeker User @relation("UserSavedJobs", fields: [seekerId], references: [id], onDelete: Cascade)
    job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

    @@unique([seekerId, jobId])
    @@index([seekerId])
    @@index([jobId])
    @@index([savedAt])
    @@map("saved_jobs")
}

// ============================================
