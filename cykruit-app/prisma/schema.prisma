// ==========================
// Generator & Datasource
// ==========================
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ==========================
// Enums
// ==========================
enum UserRole {
    SEEKER
    EMPLOYER
    ADMIN // Reserved: employer-company admin (main app, future). NOT the admin console — console staff live in the Admin model.
}

enum AccountStatus {
    PENDING // Email not verified yet
    ACTIVE // Email verified, can login
    INACTIVE // Deactivated by user (temporary)
    PENDING_DELETION // Deletion requested, 30 day grace period
    SUSPENDED // Admin suspended
    DELETED // Hard deleted
}

enum TokenType {
    EMAIL_VERIFICATION // Legacy — no longer used after OTP migration
    PASSWORD_RESET // Legacy — no longer used after OTP migration
    EMPLOYER_INVITE // For employer team invitations
    OTP_LOGIN // 6-digit OTP for passwordless login/register
    CANCEL_DELETION // Unauthenticated account-deletion cancellation link
}

enum DeviceType {
    WEB // Browser session (desktop/mobile browser)
    MOBILE // Native mobile app (iOS/Android)
    TABLET // Tablet app
    DESKTOP // Desktop app (Electron etc.)
    API // Direct API / Postman / server-to-server
}

enum SessionType {
    COOKIE // Web — httpOnly cookie, server-side session token
    JWT // Mobile — stateless access token + stored refresh token
}

// 🔔 NOTIFICATION ENUMS
enum NotificationType {
    // Job Seeker - Application Related
    APPLICATION_SUBMITTED
    APPLICATION_STATUS
    APPLICATION_WITHDRAWN
    JOB_REJECTION

    // Job Seeker - Interview Related
    INTERVIEW_SCHEDULED
    INTERVIEW_UPDATED

    // Job Seeker - Job Alerts
    JOB_ALERT
    BOOKMARK_ALERT

    // Employer - Application Related
    NEW_APPLICANT
    APPLICATION_UPDATE
    GROUPED_APPLICANTS

    // Employer - Job Related
    JOB_EXPIRY_ALERT
    JOB_APPROVAL

    // KYC Related
    KYC_APPROVED
    KYC_REJECTED

    // System & Platform
    PLATFORM_ANNOUNCEMENT
    SYSTEM_ANNOUNCEMENT
    PROFILE_REMINDER
    FEEDBACK_RECEIVED
    CERTIFICATION_ALERT
    BUG_BOUNTY_ALERT
}

enum NotificationStatus {
    UNREAD
    READ
    ARCHIVED
}

enum EmailFrequency {
    INSTANT // Send immediately
    DAILY // Daily digest
    WEEKLY // Weekly digest
    DISABLED // Don't send emails
}

enum DeliveryChannel {
    WEBSOCKET // Real-time in-app
    EMAIL // Email notification
    PUSH // Push notification (future)
    SMS // SMS notification (future)
}

enum CompanyType {
    COOPERATIVE_SOCIETY
    SOLE_PROPRIETORSHIP
    FAMILY_OWNED_BUSINESS
    PRIVATE_LIMITED_COMPANY
    PUBLIC_LIMITED_COMPANY
    EDUCATIONAL_INSTITUTION
    POLITICAL_PARTY
    NGO
    NATIONALISED_BANK
    PRIVATE_BANK
    LIFE_INSURANCE_COMPANY
    GENERAL_INSURANCE_COMPANY
    PARTNERSHIP_FIRM
    TRUST_CLUB_ASSOCIATION
    SEBI_APPROVED_BROKER
    OTHERS
}

enum Industry {
    TECHNOLOGY
    HEALTHCARE
    FINANCE
    EDUCATION
    RETAIL
    MANUFACTURING
    CONSULTING
    OTHER
}

enum CompanySize {
    SIZE_1_10 // 1-10 employees
    SIZE_11_50 // 11-50 employees
    SIZE_51_200 // 51-200 employees
    SIZE_201_500 // 201-500 employees
    SIZE_501_1000 // 501-1000 employees
    SIZE_1000_PLUS // 1000+ employees
}

enum VerificationStatus {
    PENDING
    UNDER_REVIEW
    APPROVED
    REJECTED
}

// ============================================
// ADD THESE ENUMS TO YOUR EXISTING ENUMS SECTION
// ============================================

enum JobType {
    FULL_TIME
    PART_TIME
    CONTRACT
    INTERNSHIP
}

enum WorkMode {
    REMOTE
    ONSITE
    HYBRID
}

enum ExperienceLevel {
    ENTRY
    MID
    SENIOR
}

enum ApplicationType {
    DIRECT // Apply through platform
    EXTERNAL // Redirect to external URL
    SCREENING // Answer screening questions first
}

enum QuestionType {
    SHORT_ANSWER
    SINGLE_CHOICE
    MULTIPLE_CHOICE
}

enum JobStatus {
    DRAFT // Saved as draft
    PENDING // Submitted, awaiting admin approval
    APPROVED // Admin approved, live on platform
    REJECTED // Admin rejected
    CLOSED // Manually closed by employer
    EXPIRED // Auto-expired after 45 days
}

// ==========================
// Applications and Applicants
// ==========================

enum ApplicationStatus {
    APPLIED
    UNDER_REVIEW
    SHORTLISTED
    REJECTED
    WITHDRAWN
}

enum ProfileVisibility {
    PUBLIC // Anyone can view profile
    PRIVATE // Only you can view profile
    ANONYMOUS // Skills visible, but identity hidden
}

enum JobSearchStatus {
    ACTIVELY_LOOKING // Actively searching for jobs
    OPEN_TO_OFFERS // Not actively searching, but open to opportunities
    NOT_LOOKING // Not interested in job changes
}

enum EmployerProfileVisibility {
    PUBLIC // Anyone can view company profile
    PRIVATE // Only candidates who applied can see details
}

// ============================================
// 💬 MESSAGING SYSTEM - COMPLETE IMPLEMENTATION
// ============================================

// Message Status Enum
enum MessageStatus {
    SENT // Message sent to server
    DELIVERED // Message delivered to recipient's device
    READ // Message read by recipient
    FAILED // Message failed to send
}

// Conversation Type Enum
enum ConversationType {
    DIRECT // One-on-one conversation
    JOB_INQUIRY // Job-specific conversation
}

// 1.  OAuth Provider enum
enum OAuthProvider {
    GOOGLE
    GITHUB
    LINKEDIN
    MICROSOFT
}

// ==========================
// CORE AUTH MODELS
// ==========================

// 1. USER MODEL (Core authentication)

model User {
    id        String   @id @default(uuid())
    email     String   @unique
    password  String?
    firstName String
    lastName  String
    phone     String?  @unique
    role      UserRole

    profileImage String?

    isEmailVerified Boolean   @default(false)
    emailVerifiedAt DateTime?

    status AccountStatus @default(PENDING)

    deactivatedAt       DateTime?
    deletionScheduledAt DateTime? // Set to now+30d when deletion requested

    lastLogin DateTime?

    lastLoginIp String?

    failedLoginAttempts Int       @default(0)
    lockedUntil         DateTime?
    lastFailedLoginAt   DateTime?
    lastFailedLoginIp   String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    sessions                 Session[]
    tokens                   Token[]
    notifications            Notification[]
    notificationPreference   NotificationPreference?
    jobSeekerProfile         JobSeekerProfile?
    employer                 Employer?
    applications             Application[]
    savedJobs                SavedJob[]                @relation("UserSavedJobs") // ✅ ADD THIS
    profileViews             ProfileView[]             @relation("UserProfileViews") // ✅ ADD THIS
    conversationParticipants ConversationParticipant[]
    sentMessages             Message[]                 @relation("SentMessages")
    jobViews                 JobView[]
    companyProfileViews      CompanyProfileView[]

    jobSeekerSettings   JobSeekerSettings?
    locationPreferences LocationPreference[]
    userOAuthProviders  UserOAuthProvider[]
    authAuditLogs       AuthAuditLog[]
    employerMemberships  EmployerMember[]
    roleAssignments      UserRoleAssignment[]
    permissionOverrides  UserPermissionOverride[]
    auditLogs            AuditLog[]

    @@index([email])
    @@index([status])
    @@index([role])
    @@index([lockedUntil])
    @@map("users")
}

// 2. SESSION MODEL (SSR Cookie-based auth)

model Session {
    id         String   @id @default(uuid())
    userId     String
    token      String   @unique
    expiresAt  DateTime
    rememberMe Boolean  @default(false)

    // Security tracking
    userAgent    String?
    ipAddress    String?
    lastActivity DateTime @default(now())

    // Session lifecycle
    isActive          Boolean   @default(true)
    revokedAt         DateTime?
    revokedBy         String?
    lastRotatedAt     DateTime? // FIX [11]: moved here from after relation
    deviceFingerprint String? // FIX [11]: moved here from after relation

    // Device classification
    deviceType  DeviceType  @default(WEB)
    sessionType SessionType @default(COOKIE)
    deviceName  String?
    deviceModel String?
    platform    String?
    appVersion  String?
    pushToken   String?

    // Mobile JWT tracking
    refreshTokenHash String?
    accessTokenJti   String?

    createdAt DateTime @default(now())

    // Relations — always last
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([token])
    @@index([userId])
    @@index([expiresAt])
    @@index([userId, isActive])
    @@index([userId, deviceType])
    @@index([refreshTokenHash])
    @@map("sessions")
}

// 3. TOKEN MODEL (Email verification & password reset)
model Token {
    id         String    @id @default(uuid())
    token      String    @unique // JWT or random token (hashed)
    type       TokenType
    userId     String
    employerId String?   // Set for EMPLOYER_INVITE tokens to scope by org
    expiresAt  DateTime
    usedAt     DateTime? // Mark as used instead of deleting
    metadata   Json?     // Extra context — e.g. { attempts: N } for OTP tokens
    createdAt  DateTime  @default(now())

    // Relations
    user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    employer Employer? @relation(fields: [employerId], references: [id], onDelete: Cascade)

    @@index([userId, type])
    @@index([employerId, type])
    @@index([token])
    @@index([expiresAt])
    @@index([type, expiresAt, usedAt])
    @@map("tokens")
}

// ==========================
// 🔔 NOTIFICATION SYSTEM
// ==========================

// 4. NOTIFICATION MODEL
model Notification {
    id     String             @id @default(uuid())
    userId String
    type   NotificationType
    status NotificationStatus @default(UNREAD)

    // Content
    title   String
    message String @db.Text

    // Action - UPDATED ✅
    actionUrl  String? // URL to navigate when clicked
    actionText String? // ✅ NEW: Button text like "View Application", "Reply", etc.

    // Tracking
    isRead Boolean   @default(false)
    readAt DateTime?

    // Related entity (polymorphic relationship)
    relatedEntityType String? // 'Job', 'Application', 'User', etc.
    relatedEntityId   String? // ID of related entity

    // Additional data (JSON)
    metadata Json? // Store extra data like job title, applicant name, etc.

    // Delivery tracking
    deliveredVia DeliveryChannel[] // Track which channels were used
    emailSentAt  DateTime? // When email was sent (if applicable)

    // Expiry (optional - for time-sensitive notifications)
    expiresAt DateTime?

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([userId, isRead])
    @@index([userId, type])
    @@index([status])
    @@index([createdAt])
    @@index([expiresAt])
    @@index([relatedEntityType, relatedEntityId])
    @@map("notifications")
}

// 5. NOTIFICATION PREFERENCES MODEL
model NotificationPreference {
    id     String @id @default(uuid())
    userId String @unique

    // Global toggles
    enableInApp Boolean @default(true)
    enableEmail Boolean @default(true)

    // === JOB SEEKER PREFERENCES ===

    // Applications
    applicationSubmitted_inApp Boolean @default(true)
    applicationSubmitted_email Boolean @default(true)

    applicationStatus_inApp Boolean @default(true)
    applicationStatus_email Boolean @default(true)

    jobRejection_inApp Boolean @default(true)
    jobRejection_email Boolean @default(false) // Sensitive, default off

    // Interviews
    interviewScheduled_inApp Boolean @default(true)
    interviewScheduled_email Boolean @default(true)

    // Job Alerts
    jobAlert_inApp     Boolean        @default(true)
    jobAlert_email     Boolean        @default(true)
    jobAlert_frequency EmailFrequency @default(INSTANT)

    // === EMPLOYER PREFERENCES ===

    // New Applicants
    newApplicant_inApp Boolean @default(true)
    newApplicant_email Boolean @default(true)

    applicationUpdate_inApp Boolean @default(true)
    applicationUpdate_email Boolean @default(false)

    groupedApplicants_inApp     Boolean        @default(true)
    groupedApplicants_email     Boolean        @default(true)
    groupedApplicants_frequency EmailFrequency @default(DAILY) // Batch notifications

    // Job Management
    jobExpiryAlert_inApp Boolean @default(true)
    jobExpiryAlert_email Boolean @default(true)

    jobApproval_inApp Boolean @default(true)
    jobApproval_email Boolean @default(true)

    // KYC
    kycApproved_inApp Boolean @default(true)
    kycApproved_email Boolean @default(true)

    kycRejected_inApp Boolean @default(true)
    kycRejected_email Boolean @default(true)

    // === PLATFORM-WIDE ===
    platformAnnouncement_inApp Boolean @default(true)
    platformAnnouncement_email Boolean @default(false)

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("notification_preferences")
}

// 6. NOTIFICATION QUEUE (For email digests - optional if using Bull)
model NotificationQueue {
    id     String @id @default(uuid())
    userId String

    // Queue details
    jobType        String // 'instant', 'daily_digest', 'weekly_digest'
    notificationId String // Reference to notification

    // Status
    status     String @default("pending") // pending, processing, completed, failed
    attempts   Int    @default(0)
    maxRetries Int    @default(3)

    // Scheduling
    scheduledFor DateTime? // For digest emails
    processedAt  DateTime?

    // Error tracking
    lastError String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status])
    @@index([userId])
    @@index([scheduledFor])
    @@map("notification_queue")
}

// ============================================
// CONVERSATION MODEL
// ============================================
model Conversation {
    id   String           @id @default(uuid())
    type ConversationType @default(JOB_INQUIRY)

    // Job Context (for job-specific conversations)
    jobId String?
    job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

    // Metadata
    lastMessageAt      DateTime @default(now())
    lastMessagePreview String?  @db.VarChar(200) // Preview of last message (encrypted)

    // Soft delete
    isArchived Boolean   @default(false)
    archivedAt DateTime?

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    participants ConversationParticipant[]
    messages     Message[]

    @@index([jobId])
    @@index([lastMessageAt])
    @@index([createdAt])
    @@map("conversations")
}

// ============================================
// CONVERSATION PARTICIPANTS (Junction Table)
// ============================================
model ConversationParticipant {
    id             String @id @default(uuid())
    conversationId String
    userId         String

    // Participant metadata
    role        UserRole // SEEKER or EMPLOYER
    unreadCount Int       @default(0)
    lastReadAt  DateTime?
    lastSeenAt  DateTime?

    // User preferences for this conversation
    isMuted    Boolean   @default(false)
    isPinned   Boolean   @default(false)
    isArchived Boolean   @default(false)
    archivedAt DateTime?

    // Timestamps
    joinedAt  DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([conversationId, userId]) // User can only be in conversation once
    @@index([userId])
    @@index([conversationId])
    @@index([userId, unreadCount])
    @@map("conversation_participants")
}

// ============================================
// MESSAGE MODEL
// ============================================
model Message {
    id             String @id @default(uuid())
    conversationId String
    senderId       String

    // Message Content (ENCRYPTED)
    encryptedContent String  @db.Text // Encrypted message content
    contentHash      String? // Hash for integrity verification
    iv               String? // Initialization vector for encryption

    // Message Type
    type String @default("text") // 'text', 'file', 'image', 'system'

    // File attachment (if applicable)
    fileUrl      String?
    fileName     String?
    fileSize     Int? // in bytes
    fileMimeType String?

    // Status tracking
    status MessageStatus @default(SENT)

    // Read tracking
    readBy String[]  @default([]) // Array of user IDs who read this
    readAt DateTime?

    // Delivery tracking
    deliveredTo String[]  @default([]) // Array of user IDs who received this
    deliveredAt DateTime?

    // Metadata
    isEdited  Boolean   @default(false)
    editedAt  DateTime?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    deletedBy String? // User ID who deleted

    // Reply/Thread support (optional)
    replyToId String?
    replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
    replies   Message[] @relation("MessageReplies")

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

    @@index([conversationId])
    @@index([senderId])
    @@index([createdAt])
    @@index([conversationId, createdAt])
    @@index([status])
    @@index([replyToId])
    @@map("messages")
}

// ============================================
// 📋 JOB SEEKER PROFILE MODELS
// ============================================

// 1. MAIN PROFILE

model JobSeekerProfile {
    id     String @id @default(uuid())
    userId String @unique

    firstName String
    lastName  String

    title               String?
    professionalSummary String? @db.Text

    locationId String?
    location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

    linkedin  String?
    github    String?
    portfolio String?
    professionalEmail String?

    availability String @default("Open to offers")

    profileCompletion Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
    experiences    Experience[]
    education      Education[]
    skills         JobSeekerSkill[]
    certifications JobSeekerCertification[]
    projects       Project[]
    ctfProfiles    CTFProfile[]
    resumes        Resume[]
    profileViews   ProfileView[] // ✅ ADD THIS

    @@index([userId])
    @@index([locationId])
    @@map("job_seeker_profiles")
}

// ============================================
// 2. WORK EXPERIENCE
// ============================================
model Experience {
    id        String @id @default(uuid())
    profileId String

    // Job Details
    title          String
    company        String
    location       String
    employmentType String? // "Full-time", "Part-time", "Contract", "Freelance", "Internship"

    // Dates
    startDate String // YYYY-MM format
    endDate   String? // YYYY-MM format
    current   Boolean @default(false)

    // Description
    description String @db.Text

    // Tools & Technologies (Array)
    tools        String[] // e.g., ["Burp Suite", "Metasploit"]
    achievements String[] // Optional achievements

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

    @@index([profileId])
    @@index([current])
    @@map("experiences")
}

// ============================================
// 3. EDUCATION
// ============================================
model Education {
    id        String @id @default(uuid())
    profileId String

    // Education Details
    degree       String
    fieldOfStudy String?

    // Institute (Support both predefined and custom)
    instituteId   String? // NULL if custom
    instituteName String? // Used if custom

    // Dates
    startDate String? // YYYY format
    endDate   String? // YYYY format or "Present"

    // Additional Info
    grade       String? // e.g., "3.8 GPA", "First Class"
    description String? @db.Text

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    profile   JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    institute Institute?       @relation(fields: [instituteId], references: [id], onDelete: SetNull)

    @@index([profileId])
    @@index([instituteId])
    @@map("education")
}

// ============================================
// 4. PROJECTS
// ============================================
model Project {
    id        String @id @default(uuid())
    profileId String

    // Project Details
    title       String
    description String @db.Text

    // Tech Stack
    technologies String[] // e.g., ["Python", "React", "Docker"]

    // Links
    projectUrl String? // GitHub, live demo, etc.

    // Dates
    startDate String? // YYYY-MM format
    endDate   String? // YYYY-MM format
    current   Boolean @default(false)

    // Highlights (Optional)
    highlights String[]

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

    @@index([profileId])
    @@map("projects")
}

// ============================================
// 5. CTF & BUG BOUNTY PROFILES
// ============================================
model CTFProfile {
    id        String @id @default(uuid())
    profileId String

    // Platform Details (Free text - user enters everything)
    platform   String // e.g., "HackTheBox", "TryHackMe"
    username   String
    profileUrl String

    // Optional Stats
    rank   String? // e.g., "Pro Hacker"
    points Int? // e.g., 5000

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

    @@index([profileId])
    @@map("ctf_profiles")
}

// ============================================
// 6. RESUMES (Multiple uploads, max 5)
// ============================================
model Resume {
    id        String @id @default(uuid())
    profileId String

    // File Details
    fileName String
    fileUrl  String // S3 URL
    fileSize Int // in bytes
    fileType String // e.g., "application/pdf"

    // Timestamps
    uploadedAt DateTime @default(now())

    // Relations
    profile      JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    applications Application[]

    @@index([profileId])
    @@map("resumes")
}

// ============================================
// 📚 SKILLS SYSTEM (Pre-populated)
// ============================================

// 7. SKILL CATEGORIES
model SkillCategory {
    id          String   @id @default(uuid())
    name        String   @unique // e.g., "Offensive Security", "Programming"
    description String?
    createdAt   DateTime @default(now())

    // Relations
    skills Skill[]

    @@map("skill_categories")
}

// 8. SKILLS (Pre-populated by admin)
model Skill {
    id          String  @id @default(uuid())
    name        String  @unique // e.g., "Penetration Testing", "Python"
    categoryId  String
    description String?
    isVerified  Boolean @default(true) // Admin-added = verified

    createdAt DateTime @default(now())

    // Relations
    category        SkillCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    jobSeekerSkills JobSeekerSkill[]
    jobSkills       JobSkill[]

    @@index([categoryId])
    @@index([name])
    @@map("skills")
}

// 9. JOB SEEKER SKILLS (Junction table with proficiency)
model JobSeekerSkill {
    id        String @id @default(uuid())
    profileId String
    skillId   String

    // Proficiency Level
    proficiency       String // "Beginner", "Intermediate", "Expert"
    yearsOfExperience Int? // Optional

    // Timestamps
    addedAt DateTime @default(now())

    // Relations
    profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    skill   Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

    @@unique([profileId, skillId]) // User can't add same skill twice
    @@index([profileId])
    @@index([skillId])
    @@map("job_seeker_skills")
}

// ============================================
// 🎓 CERTIFICATIONS SYSTEM (Pre-populated)
// ============================================

// 10. CERTIFICATIONS (Pre-populated by admin)
model Certification {
    id           String  @id @default(uuid())
    name         String  @unique // e.g., "OSCP", "CEH"
    organization String // e.g., "Offensive Security"
    description  String?
    isVerified   Boolean @default(true) // Admin-added = verified

    createdAt DateTime @default(now())

    // Relations
    jobSeekerCertifications JobSeekerCertification[]
    jobCertifications       JobCertification[]

    @@index([name])
    @@index([organization])
    @@map("certifications")
}

// 11. JOB SEEKER CERTIFICATIONS (Junction table with dates)
model JobSeekerCertification {
    id              String @id @default(uuid())
    profileId       String
    certificationId String

    // Dates
    issueDate  String // YYYY-MM format
    expiryDate String? // YYYY-MM format (optional)

    // Credentials
    credentialId  String? // e.g., "ABC123XYZ"
    credentialUrl String? // Verification URL

    // Certificate File (Optional upload)
    certificateFile String? // S3 URL

    // Timestamps
    addedAt DateTime @default(now())

    // Relations
    profile       JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    certification Certification    @relation(fields: [certificationId], references: [id], onDelete: Cascade)

    @@unique([profileId, certificationId]) // User can't add same cert twice
    @@index([profileId])
    @@index([certificationId])
    @@map("job_seeker_certifications")
}

