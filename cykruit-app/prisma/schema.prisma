    @@index([isVerified])
    @@index([companyType])
    @@index([industry])
    @@map("employers")
}

// ============================================
// EMPLOYER VERIFICATION MODEL
// ============================================
model EmployerVerification {
    id         String   @id @default(uuid())
    employerId String
    employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

    // ============================================
    // VERIFICATION DATA (Snapshot at submission)
    // ============================================
    companyName    String
    companyWebsite String
    companyType    CompanyType
    industry       Industry
    companySize    CompanySize
    location       String

    // ============================================
    // DOCUMENT (Only ONE document)
    // ============================================
    documentUrl      String // S3 public URL
    documentKey      String // S3 key for deletion
    documentFileName String // Original filename

    // ============================================
    // STATUS & TRACKING
    // ============================================
    status          VerificationStatus @default(PENDING)
    submissionCount Int                @default(1) // How many times resubmitted
    isLatest        Boolean            @default(true) // Only one active verification

    // ============================================
    // ADMIN REVIEW
    // ============================================
    reviewedBy      String?   @db.Uuid // ✅ ADD @db.Uuid here
    reviewer        Admin?    @relation("VerificationReviewer", fields: [reviewedBy], references: [id])
    reviewedAt      DateTime?
    rejectionReason String?   @db.Text
    adminNotes      String?   @db.Text // Internal notes for admins

    // ============================================
    // RE-VERIFICATION TRACKING
    // ============================================
    previousVerificationId String?
    previousVerification   EmployerVerification?  @relation("VerificationHistory", fields: [previousVerificationId], references: [id])
    nextVerifications      EmployerVerification[] @relation("VerificationHistory")

    // ============================================
    // AUDIT TRAIL
    // ============================================
    statusHistory Json[] @default([]) // Array of status changes
    // Example: [
    //   {status: 'PENDING', timestamp: '2024-01-01T10:00:00Z', by: 'system'},
    //   {status: 'UNDER_REVIEW', timestamp: '2024-01-02T14:30:00Z', by: 'admin123'},
    //   {status: 'REJECTED', timestamp: '2024-01-03T16:45:00Z', by: 'admin123', reason: 'Invalid document'}
    // ]

    // ============================================
    // TIMESTAMPS
    // ============================================
    submittedAt DateTime @default(now())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([employerId])
    @@index([status])
    @@index([isLatest])
    @@index([reviewedBy])
    @@index([submittedAt])
    @@map("employer_verifications")
}

