// ==========================
// ADMIN MODELS (Add these to the end of your schema)
// ==========================

model Admin {
    id        String @id @default(uuid()) @db.Uuid // ✅ ADD @db.Uuid here
    email     String @unique
    password  String
    firstName String
    lastName  String

    phone        String?
    profileImage String?

    isActive Boolean @default(true) // Kill switch — blocks login and session validation

    lastLogin   DateTime?
    lastLoginIp String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    auditLogs           AdminAuditLog[]
    authAuditLogs       AdminAuthAuditLog[]
    verificationReviews EmployerVerification[] @relation("VerificationReviewer")
    sessions            AdminSession[]
    roleAssignments     AdminRoleAssignment[]
    permissionOverrides AdminPermissionOverride[]

    @@index([email])
    @@map("admins")
}

model AdminSession {
    id           String   @id @default(uuid())
    adminId      String   @db.Uuid
    token        String   @unique
    expiresAt    DateTime
    rememberMe   Boolean  @default(false)
    userAgent    String?
    ipAddress    String?
    lastActivity DateTime @default(now())
    createdAt    DateTime @default(now())

    admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

    @@index([token])
    @@index([adminId])
    @@index([expiresAt])
    @@map("admin_sessions")
}

model AdminAuditLog {
    id      String @id @default(uuid())
    adminId String @db.Uuid
    admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

    action     String // "kyc:review", "jobs:review", etc. (registry action or specific verb)
    module     String  @default("") // "kyc", "jobs", "users", "rbac", "subscriptions", ...
    resource   String? // "EmployerVerification", "Job", "User", etc.
    resourceId String? // ID of the affected resource

    riskLevel String  @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
    result    String  @default("SUCCESS") // SUCCESS | FAILURE | DENIED
    reason    String?

    ipAddress String?
    userAgent String?

    // Store before/after data for complete audit trail
    oldData  Json?
    newData  Json?
    metadata Json? // Additional context

    createdAt DateTime @default(now())

    @@index([adminId])
    @@index([action])
    @@index([module])
    @@index([riskLevel])
    @@index([result])
    @@index([createdAt])
    @@index([resource, resourceId])
    @@map("admin_audit_logs")
}

model AuthAuditLog {
    id        String   @id @default(uuid())
    action    String // LOGIN_SUCCESS, LOGIN_FAILURE, LOGOUT, etc.
    status    String // SUCCESS | FAILURE
    userId    String? // Nullable — failed logins for unknown emails have no userId
    ipAddress String?
    userAgent String?
    sessionId String?
    metadata  Json? // Extra context — attempts, providers, reason, etc.
    createdAt DateTime @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([userId])
    @@index([action])
    @@index([createdAt])
    @@index([status])
    @@map("auth_audit_logs")
}

// Admin console's own login/logout trail — mirrors AuthAuditLog but keyed to Admin.
// Kept separate from AdminAuditLog (business mutations) so login noise doesn't
// mix with action history; the two are queried together for the unified
// "Audit Logs" (auth) tab in admin-ui.
model AdminAuthAuditLog {
    id        String   @id @default(uuid())
    action    String // ADMIN_LOGIN_SUCCESS, ADMIN_LOGIN_FAILURE, ADMIN_LOGOUT
    status    String // SUCCESS | FAILURE
    adminId   String?  @db.Uuid // Nullable — failed logins for unknown emails have no adminId
    ipAddress String?
    userAgent String?
    metadata  Json?
    createdAt DateTime @default(now())

    admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

    @@index([adminId])
    @@index([action])
    @@index([createdAt])
    @@index([status])
    @@map("admin_auth_audit_logs")
}

// OAuth Provider tracking table
model UserOAuthProvider {
    id     String @id @default(uuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Provider details
    provider   OAuthProvider
    providerId String // Unique ID from provider (e.g., Google's sub)

    // Profile data from provider
    email   String? // Email from provider
    name    String?
    picture String? // Profile picture URL

    // Token info (optional - if you want to store it)
    accessToken  String?   @db.Text
    refreshToken String?   @db.Text
    expiresAt    DateTime?

    // Tracking
    linkedAt   DateTime @default(now())
    lastUsedAt DateTime @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, provider]) // One provider per user
    @@unique([provider, providerId]) // Unique provider ID
    @@index([userId])
    @@index([provider, providerId])
    @@map("user_oauth_providers")
}

// ==========================
// EMPLOYER TEAM MODELS
// ==========================

enum EmployerMemberRole {
    OWNER
    HIRING_MANAGER
    RECRUITER
    VIEWER
}

model EmployerMember {
    id         String             @id @default(uuid())
    employerId String
    employer   Employer           @relation(fields: [employerId], references: [id], onDelete: Cascade)
    userId     String
    user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    role       EmployerMemberRole @default(RECRUITER)
    invitedBy  String?            // userId of who invited this member

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([employerId, userId])
    @@index([employerId])
    @@index([userId])
    @@map("employer_members")
}

// ==========================
// SUBSCRIPTION MODELS
// ==========================

model SubscriptionPackage {
    id          String  @id @default(uuid())
    name        String  @unique
    description String?
    isActive    Boolean @default(true)

    maxActiveJobs    Int     @default(5)
    maxTeamMembers   Int     @default(3)
    featuredJobSlots Int     @default(0)
    aiScoringEnabled Boolean @default(false)

    priceMonthly Decimal? @db.Decimal(10, 2)
    priceYearly  Decimal? @db.Decimal(10, 2)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    subscriptions EmployerSubscription[]

    @@index([isActive])
    @@map("subscription_packages")
}

model EmployerSubscription {
    id         String   @id @default(uuid())
    employerId String   @unique
    employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
    packageId  String
    package    SubscriptionPackage @relation(fields: [packageId], references: [id])

    status    String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
    startedAt DateTime @default(now())
    expiresAt DateTime?

    // Cached usage counters — refreshed periodically, not authoritative for hard limits
    currentActiveJobs    Int @default(0)
    currentTeamMembers   Int @default(0)
    usedFeaturedJobSlots Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([employerId])
    @@index([status])
    @@index([expiresAt])
    @@map("employer_subscriptions")
}

// ==========================
// General Audit Log (admin-app)
// ==========================

model AuditLog {
    id         String   @id @default(uuid())
    actorId    String
    actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
    actorRole  String   @default("ADMIN")
    action     String
    module     String
    targetType String?
    targetId   String?
    oldData    Json?
    newData    Json?
    riskLevel  String   @default("LOW")
    result     String
    reason     String?
    ipAddress  String?
    metadata   Json?
    createdAt  DateTime @default(now())

    @@index([actorId])
    @@index([module])
    @@index([result])
    @@index([riskLevel])
    @@index([createdAt])
    @@map("audit_logs")
}

// ==========================
// RBAC (Permission System)
// ==========================

model Permission {
    id          String   @id @default(uuid())
    module      String
    action      String
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())

    rolePermissions     RolePermission[]
    userOverrides       UserPermissionOverride[]

    @@unique([module, action])
    @@index([isActive])
    @@map("permissions")
}

model RbacRole {
    id          String   @id @default(uuid())
    name        String   @unique
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    permissions  RolePermission[]
    assignments  UserRoleAssignment[]

    @@map("rbac_roles")
}


model RolePermission {
    id           String     @id @default(uuid())
    roleId       String
    role         RbacRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permissionId String
    permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@unique([roleId, permissionId])
    @@map("role_permissions")
}

model UserRoleAssignment {
    id         String    @id @default(uuid())
    userId     String
    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    roleId     String
    role       RbacRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
    employerId String?
    expiresAt  DateTime?
    assignedBy String?
    createdAt  DateTime  @default(now())

    @@unique([userId, roleId, employerId])
    @@index([userId])
    @@index([employerId])
    @@map("user_role_assignments")
}

model UserPermissionOverride {
    id           String     @id @default(uuid())
    userId       String
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    permissionId String
    permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
    employerId   String?
    grant        Boolean
    grantedBy    String?
    reason       String?
    createdAt    DateTime   @default(now())

    @@unique([userId, permissionId, employerId])
    @@index([userId])
    @@index([employerId])
    @@map("user_permission_overrides")
}

// ==========================
// Admin console RBAC — fully separated from the main-app RBAC set above.
// FK target is Admin (console staff), never User. Global scope only (no employerId).
// Catalog is seeded from admin-app/src/admin/rbac/permissions.registry.ts (npm run rbac:seed)
// — never edit these rows by hand.
// ==========================

model AdminPermission {
    id          String   @id @default(uuid())
    module      String // "kyc", "jobs", "users", ...
    action      String // "view", "review", "manage", ...
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())

    rolePermissions AdminRolePermission[]
    adminOverrides  AdminPermissionOverride[]

    @@unique([module, action])
    @@index([isActive])
    @@map("admin_permissions")
}

model AdminRbacRole {
    id          String   @id @default(uuid())
    name        String   @unique // system roles: super_admin | platform_admin | reviewer
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    permissions AdminRolePermission[]
    assignments AdminRoleAssignment[]

    @@map("admin_rbac_roles")
}

model AdminRolePermission {
    id           String          @id @default(uuid())
    roleId       String
    role         AdminRbacRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permissionId String
    permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@unique([roleId, permissionId])
    @@map("admin_role_permissions")
}

model AdminRoleAssignment {
    id         String        @id @default(uuid())
    adminId    String        @db.Uuid
    admin      Admin         @relation(fields: [adminId], references: [id], onDelete: Cascade)
    roleId     String
    role       AdminRbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
    expiresAt  DateTime?
    assignedBy String?
    createdAt  DateTime      @default(now())

    @@unique([adminId, roleId])
    @@index([adminId])
    @@map("admin_role_assignments")
}

model AdminPermissionOverride {
    id           String          @id @default(uuid())
    adminId      String          @db.Uuid
    admin        Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)
    permissionId String
    permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
    grant        Boolean // true = force grant, false = force deny (deny always wins)
    grantedBy    String?
    reason       String?
    createdAt    DateTime        @default(now())

    @@unique([adminId, permissionId])
    @@index([adminId])
    @@map("admin_permission_overrides")
}
