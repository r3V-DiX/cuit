    // ============================================
    companyWebsite String?
    contactEmail   String?
    foundedYear    Int?

    // NEW: Additional editable fields ✅
    tagline            String? // Company tagline
    cultureDescription String? @db.Text // Culture description

    // Branding
    companyLogo   String? // S3 URL
    companyBanner String? // S3 URL

    // About Company
    about   String? @db.Text
    mission String? @db.Text
    vision  String? @db.Text

    // Social Links
    linkedin  String?
    twitter   String?
    facebook  String?
    instagram String? // NEW: Instagram link ✅

