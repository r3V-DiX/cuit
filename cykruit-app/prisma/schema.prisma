    // ============================================
    // VERIFICATION STATUS
    // ============================================
    isVerified Boolean   @default(false)
    verifiedAt DateTime?
    verifiedBy String? // Admin ID who approved

    // ============================================
    // FLAGS
    // ============================================
    isActive  Boolean @default(true)
    isFlagged Boolean @default(false)

    // ============================================
