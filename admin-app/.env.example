NODE_ENV=development
ADMIN_PORT=4010
HOST=0.0.0.0

# Same database as cykruit-app
DATABASE_URL=postgresql://user:password@localhost:5432/cykruit

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT — MUST be different from main service JWT_SECRET
JWT_SECRET=admin-separate-jwt-secret-change-this
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS — admin dashboard origin
CORS_ORIGIN=http://localhost:3100,https://admin.cykruit.com

# admin-ui origin — used to build admin-invite links
ADMIN_APP_URL=http://localhost:3100

# Sibling cykruit-app service URLs — used by the System Health panel (TASK B14)
# and by admin proxying (e.g. subscription management). Same env var names as
# apps/gateway/src/main.ts's SERVICES map.
AI_SERVICE_URL=http://localhost:3005
AUTH_SERVICE_URL=http://localhost:4001
SETTINGS_SERVICE_URL=http://localhost:4002
SEEKER_PROFILE_SERVICE_URL=http://localhost:4003
EMPLOYER_SERVICE_URL=http://localhost:4004
SEEKER_SERVICE_URL=http://localhost:4005
PUBLIC_SERVICE_URL=http://localhost:4006
NOTIFICATION_SERVICE_URL=http://localhost:4007
SUBSCRIPTION_SERVICE_URL=http://localhost:4008
GATEWAY_URL=http://localhost:5000

# Mail (reuse same config)
RESEND_API_KEY=
MAIL_FROM=noreply@cykruit.com

RBAC_BOOTSTRAP_ADMIN_EMAIL=admin@cykruit.com