NODE_ENV=development
ADMIN_PORT=4010
HOST=0.0.0.0

# Same database as cykruit-app
DATABASE_URL=postgresql://user:password@localhost:5432/cykruit

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT — MUST be different from main service JWT_SECRET
JWT_SECRET=admin-separate-jwt-secret-change-this
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS — admin dashboard origin
CORS_ORIGIN=http://localhost:3100,https://admin.cykruit.com

# Mail (reuse same config)
RESEND_API_KEY=
MAIL_FROM=noreply@cykruit.com
