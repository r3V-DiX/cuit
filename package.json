{
  "name": "cykruit-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Cykruit Backend - Monorepo",
  "license": "MIT",
  "overrides": {
    "lodash": "^4.17.21",
    "minimatch": "^10.2.1",
    "ajv": "^8.17.2",
    "glob": "^10.3.10"
  },
  "scripts": {
    "start:auth": "ts-node -r ./tsconfig-paths-bootstrap.js --project apps/auth-service/tsconfig.json apps/auth-service/src/main.ts",
    "start:auth:dev": "ts-node-dev --respawn -r ./tsconfig-paths-bootstrap.js --project apps/auth-service/tsconfig.json apps/auth-service/src/main.ts",
    "typecheck:auth": "tsc --noEmit --project apps/auth-service/tsconfig.json --watch",
    "typecheck:auth:ci": "tsc --noEmit --project apps/auth-service/tsconfig.json",
    "build:auth": "tsc -p apps/auth-service/tsconfig.build.json",
    "start:auth:prod": "node dist/apps/auth-service/main.js",

    "start:settings": "ts-node -r ./tsconfig-paths-bootstrap.js --project apps/user-settings-service/tsconfig.json apps/user-settings-service/src/main.ts",
    "start:settings:dev": "ts-node-dev --respawn -r ./tsconfig-paths-bootstrap.js --project apps/user-settings-service/tsconfig.json apps/user-settings-service/src/main.ts",
    "typecheck:settings": "tsc --noEmit --project apps/user-settings-service/tsconfig.json --watch",
    "typecheck:settings:ci": "tsc --noEmit --project apps/user-settings-service/tsconfig.json",
    "build:settings": "tsc -p apps/user-settings-service/tsconfig.build.json",
    "start:settings:prod": "node dist/apps/user-settings-service/main.js",
    
    "start:seeker-profile": "ts-node -r ./tsconfig-paths-bootstrap.js --project apps/seeker-profile-service/tsconfig.json apps/seeker-profile-service/src/main.ts",
    "start:seeker-profile:dev": "ts-node-dev --respawn -r ./tsconfig-paths-bootstrap.js --project apps/seeker-profile-service/tsconfig.json apps/seeker-profile-service/src/main.ts",
    "build:seeker-profile": "tsc -p apps/seeker-profile-service/tsconfig.build.json",
    "start:seeker-profile:prod": "node dist/apps/seeker-profile-service/main.js",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/client-ses": "^3.873.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@google/generative-ai": "^0.24.1",
    "@nest-lab/throttler-storage-redis": "^1.0.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.9",
    "@prisma/client": "^6.16.2",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.3.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsdom": "^27.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.0.1",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^3.15.9",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "@cykruit/prisma": "<rootDir>/libs/prisma/src/index.ts",
      "@cykruit/config": "<rootDir>/libs/config/src/index.ts",
      "@cykruit/context": "<rootDir>/libs/context/src/index.ts",
      "@cykruit/logger": "<rootDir>/libs/logger/src/index.ts",
      "@cykruit/common": "<rootDir>/libs/common/src/index.ts",
      "@cykruit/auth-core": "<rootDir>/libs/auth-core/src/index.ts",
      "@cykruit/queue": "<rootDir>/libs/queue/src/index.ts",
      "@cykruit/mail": "<rootDir>/libs/mail/src/index.ts",
      "@cykruit/upload": "<rootDir>/libs/upload/src/index.ts",
      "@cykruit/ai": "<rootDir>/libs/ai/src/index.ts",
      "@cykruit/rate-limit": "<rootDir>/libs/rate-limit/src/index.ts",
      "@cykruit/audit": "<rootDir>/libs/audit/src/index.ts"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
